{
    "layer": "top",
    "reload_style_on_change": true,
    "modules-left": [ "group/group-power", "sway/workspaces", "sway/mode"],
    "modules-center": [ "group/clocktray"],
    "modules-right": ["group/hardware", "group/status"],

    "group/status": {
        "orientation": "inherit",
        "modules": [  "wireplumber#source", "wireplumber#sink", "battery", "network", "tray" ]
    },

    "group/hardware": {
        "orientation": "inherit",
        "modules": [ "memory", "cpu" ]
    },

    "group/clocktray": {
        "orientation": "inherit",
        "modules": ["clock" ]
    },

    "group/group-power": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-power",
            "transition-left-to-right": true,
            "click-to-reveal": true
        },
        "modules": [
            "custom/icon",
            "custom/power",
            "custom/quit",
            "custom/lock",
            "custom/reboot"
        ]
    },

    "sway/window": {
        "max-length": 50
    },

    "sway/workspaces": {
        "format": "{icon}",
        "persistent-workspaces": {
            "1": ["HDMI-A-1"],
            "2": ["HDMI-A-1"],
            "3": ["HDMI-A-1"],
            "10": ["DP-2"]
        },
        "format-icons": {
            "1": "",
            "2": "󰈹",
            "3": "",
            "10": "󰙯",
            "urgent": "",
            "default": ""
        }
    },

    "sway/mode": {
        "format": " {}",
        "max-length": 50
    },

    "tray": {
        "spacing": 5
    },

    "battery": {
        "format": "{icon}",
        "full-at": 80,
        "interval": 5,

        "states": { "100": 100, "90": 90, "80": 80, "70": 70, "60": 60, "50": 50, "40": 40, "30": 30, "20": 20, "10": 10, "0": 0 },

        // "format-discharging-0": "󰂎",
        // "format-discharging-10": "󰁺",
        // "format-discharging-20": "󰁻",
        // "format-discharging-30": "󰁼",
        // "format-discharging-40": "󰁽",
        // "format-discharging-50": "󰁾",
        // "format-discharging-60": "󰁿",
        // "format-discharging-70": "󰂀",
        // "format-discharging-80": "󰂁",
        // "format-discharging-90": "󰂂",
        // "format-discharging-100": "󰁹",

        "format-charging-0": "󰢟 ",
        "format-charging-10": "󰢜 ",
        "format-charging-20": "󰂆 ",
        "format-charging-30": "󰂇 ",
        "format-charging-40": "󰂈 ",
        "format-charging-50": "󰢝 ",
        "format-charging-60": "󰂉 ",
        "format-charging-70": "󰢞 ",
        "format-charging-80": "󰂊 ",
        "format-charging-90": "󰂋 ",
        "format-charging-100": "󰂅 ",

        "format-plugged": "󰚥",


        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format-charging": "{timeTo}\nCharge: {capacity}%\nPower: {power}W\nHealth: {health}\nCycles: {cycles}",
        "tooltip-format-discharging": "{timeTo}\nCharge: {capacity}%\nPower: {power}W\nHealth: {health}\nCycles: {cycles}",
        "tooltip-format-plugged": "AC connected\nNot Charging\nCharge: {capacity}%\nPower: {power}W\nHealth: {health}\nCycles: {cycles}"
    },

    "network": {
        "format-ethernet": "",
        "format-wifi": "{icon}",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-ethernet": "Ethernet ({ifname})\n{ipaddr}/{cidr}\n{bandwidthUpBytes} Up\n{bandwidthDownBytes} Down\nGateway: {gwaddr}",
        "tooltip-format-wifi": "Wifi ({ifname})\n{essid}\n{ipaddr}/{cidr}\n{bandwidthUpBytes} Up\n{bandwidthDownBytes} Down\nGateway: {gwaddr}\nAP: {bssid}\nSignal: {signalStrength}% ({signaldBm}dBm)\nFrequency: {frequency}GHz"
    },

    "cpu": {
        "interval": 1,
        "format": "{icon} {usage}%",
        "format-icons": [
            "<span color='#f8f8f2'></span>", // white
            "<span color='#69ff94'></span>", // green
            "<span color='#69ff94'></span>", // green
            "<span color='#2aa9ff'></span>", // blue
            "<span color='#2aa9ff'></span>", // blue
            "<span color='#ffffa5'></span>", // yellow
            "<span color='#ffffa5'></span>", // yellow
            "<span color='#ff9977'></span>", // orange
            "<span color='#dd532e'></span>"  // red
        ]
    },

    "memory": {
        "interval": 1,
        "format": " {percentage}%",
        "tooltip-format": "MEM: {used}/{total}GiB {percentage}%\nSWP: {swapUsed}/{swapTotal}GiB {swapPercentage}%"
    },


    "clock": {
        "interval": 1,
        "locale": "en_GB.UTF-8",
        "format": " {:%H:%M}",
        "format-alt": " {:L%A, %B %d, %Y (%H:%M:%S)}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode"          : "year",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "format": {
                "months":     "<span color='#ffead3'><b>{}</b></span>",
                "days":       "<span color='#ecc6d9'><b>{}</b></span>",
                "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
                "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
                "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
        "actions":  {
            "on-click-right": "mode",
            "on-scroll-up": "tz_up",
            "on-scroll-down": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "wireplumber#sink": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": ["", "", " "],
        "tooltip-format": "{node_name}: {volume}%",
        "scroll-step": 5,
        "on-click-left": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "wireplumber#source": {
        "node-type": "Audio/Source",
        "format": "{icon}",
        "format-muted": "󰍭",
        "format-icons": ["󰍬"],
        "tooltip-format": "{node_name}: {volume}%",
        "scroll-step": 5,
        "on-click-left": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
    },

    "custom/icon": {
        "format": "󱄅"
    },

    "custom/quit": {
        "format": "󰗼",
        "tooltip-format": "Logout",
        "on-click": "sway exit"
    },

    "custom/lock": {
        "format": "󰍁",
        "tooltip-format": "Lock",
        "on-click": "$XDG_CONFIG_HOME/waybar/lock.sh"
    },

    "custom/reboot": {
        "format": "󰜉",
        "tooltip-format": "Reboot",
        "on-click": "reboot"
    },

    "custom/power": {
        "format": "",
        "tooltip-format": "Shutdown",
        "on-click": "shutdown now"
    }
}
